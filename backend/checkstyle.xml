<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">
<!--
  v0 minimal Checkstyle configuration.

  Design §10 originally specified google_checks; we use a relaxed subset here because Spotless
  google-java-format (Google style, 2-space indent) already handles formatting, so Checkstyle only
  guards against hygiene regressions (tabs, trailing junk, unused imports, line length).
  Documented in pending-adjustments.md.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="charset" value="UTF-8"/>
  <property name="fileExtensions" value="java"/>

  <module name="FileTabCharacter">
    <property name="eachLine" value="true"/>
  </module>

  <module name="NewlineAtEndOfFile">
    <property name="lineSeparator" value="lf"/>
  </module>

  <module name="LineLength">
    <property name="max" value="120"/>
    <property name="ignorePattern"
              value="^package.*|^import.*|a href|href|http://|https://|ftp://|@link"/>
  </module>

  <module name="TreeWalker">
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="AvoidStarImport"/>
    <module name="OuterTypeFilename"/>
  </module>
</module>
